{
  "expo": {
    "name": "Passaporte Esportivo",
    "slug": "passaporte-esportivo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "passaporteesportivo",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF9E8",
    "ios": {
      "bundleIdentifier": "br.com.passaporteesportivo.app",
      "supportsTablet": false
    },
    "android": {
      "package": "br.com.passaporteesportivo.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#123A32"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#123A32",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "d7d0f1df-7095-4ee8-a661-7b47ebd135da"
      }
    },
    "owner": "francooo"
  }
}
