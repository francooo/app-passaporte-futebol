# Copie para .env.local e preencha. Na Vercel, cadastre em Project → Settings → Environment Variables.

# Fase 1 — banco (Neon) e autenticação
DATABASE_URL=
AUTH_SECRET=
# URL pública do app (links de e-mail). Na Vercel pode ficar vazio: usa o domínio de produção.
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESEND_API_KEY=
# Remetente verificado no Resend (padrão: onboarding@resend.dev, só envia para o dono da conta)
EMAIL_FROM=

# Fase 3 — fotos (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
